{
  "name": "sazo",
  "private": true,
  "description": "SAZO \u2014 vehicle history, verification and intelligence platform (Uganda / East Africa)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/trust-engine packages/scenarios",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint . && npm run lint:boundaries",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "db:migrate": "node db/migrate.mjs",
    "db:test": "node db/migrate.mjs --test",
    "dev:services": "docker compose up -d --wait"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
