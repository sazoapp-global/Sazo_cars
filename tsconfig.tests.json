{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "paths": {
      "@sazo/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@sazo/trust-engine": [
        "./packages/trust-engine/src/index.ts"
      ],
      "@sazo/scenarios": [
        "./packages/scenarios/src/index.ts"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "apps/web/**",
    "apps/garage/**"
  ]
}
