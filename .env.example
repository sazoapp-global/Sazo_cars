# Copy to .env for local development
DATABASE_URL=postgres://sazo:sazo@localhost:5432/sazo
REDIS_URL=redis://localhost:6379
PORT=3000

# Sign-in secrets — 32+ random characters each; never commit real values.
# Development has built-in defaults; production refuses to start without these.
# JWT_SECRET=
# HMAC_SECRET=          # hashes one-time codes and phone numbers
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# SMS: "console" prints codes to the log (dev). Production needs Africa's Talking.
SMS_PROVIDER=console
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_SANDBOX=true

# Personal data (names, phone numbers) is encrypted with this key — 32 bytes, base64. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PII_ENCRYPTION_KEY=

# Evidence photos (write-once). Local folder for now.
EVIDENCE_DIR=./var/evidence
# Addresses used in links: SMS confirmation links (web) and photo upload URLs (API)
PUBLIC_WEB_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000
